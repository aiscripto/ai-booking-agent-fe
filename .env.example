# ─── Frontend build-time config ─────────────────────────────────────────────
# Copy to .env for local development.
#
# NOTE: every VITE_* variable is embedded in the production bundle and is
# visible to every browser that loads the app. Never put a secret here.
#
# Read in exactly one place: src/config/env.ts
# ────────────────────────────────────────────────────────────────────────────

# Base URL for the API. Leave it UNSET everywhere (production and local dev).
#   production — it defaults to the relative path /api/v1, which nginx reverse-proxies to the api
#                container (see nginx.conf). No host or port is baked into the bundle.
#   local dev  — the Vite dev server forwards /api to the backend named below (see vite.config.ts),
#                so the browser still sees one origin and the sign-in cookie works.
# VITE_API_BASE_URL=

# Local development only (not embedded in the bundle): where the dev server forwards /api.
#   a backend running on your computer:   http://localhost:3031   (use the port your backend listens on)
#   the test VM:                          http://<vm-address>:3031
VITE_DEV_API_TARGET=http://localhost:5000
